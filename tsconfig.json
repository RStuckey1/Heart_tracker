{

  "compilerOptions": {

    "target": "ES2020",

    "module": "ESNext",

    "moduleResolution": "node",

    "esModuleInterop": true,

    "outDir": "./dist",

    "rootDir": "./HeartTracker",

    "strict": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true

  },

  "include": ["HeartTracker/**/*"],

  "exclude": ["node_modules"]

}

